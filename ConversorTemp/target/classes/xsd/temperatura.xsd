<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           xmlns:tns="http://umg.com/compiladores/temperatura"
           targetNamespace="http://umg.com/compiladores/temperatura"
           elementFormDefault="qualified">

    <!-- Petición: el cliente envía un valor en Celsius -->
    <xs:element name="convertirTemperaturaRequest">
        <xs:complexType>
            <xs:sequence>
                <xs:element name="celsius" type="xs:double"/>
            </xs:sequence>
        </xs:complexType>
    </xs:element>

    <!-- Respuesta: el servidor devuelve el valor convertido a Fahrenheit -->
    <xs:element name="convertirTemperaturaResponse">
        <xs:complexType>
            <xs:sequence>
                <xs:element name="celsius" type="xs:double"/>
                <xs:element name="fahrenheit" type="xs:double"/>
            </xs:sequence>
        </xs:complexType>
    </xs:element>

</xs:schema>